node_modules/
dist/
.env
.env.*
*.local
.DS_Store
*.log
.cursia_vps_key

# QA outputs — pueden contener referencias a videos/URLs de prueba, nunca se versionan
qa_youtube_real_snapshot.json
qa_*.json

# Worktrees de agentes (scratch, nunca versionado)
.claude/worktrees/

# Cursia H5P Library Pack y paquetes .h5p: salida de build, nunca se versionan
*.h5p
h5p-library-pack/

# EV6 H5P v2: el store versionado de librerías H5P SÍ se versiona, incluidas sus
# carpetas `dist/` (código de las librerías upstream, no salida de build de Cursia).
!assets/h5p-libs/v2/*/dist/
# UX #5 (r18): store v3 (CURSIA_H5P_PROFILE_V3), mismo criterio.
!assets/h5p-libs/v3/*/dist/
